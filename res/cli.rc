// Resources of the console tools (sdrloader-cli.exe, sdi-tests.exe).
#include <windows.h>
#include "../src/version.hpp"

1 ICON "sdrloader.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SDI_VERSION_MAJOR,SDI_VERSION_MINOR,SDI_VERSION_PATCH,0
 PRODUCTVERSION SDI_VERSION_MAJOR,SDI_VERSION_MINOR,SDI_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "SDRLoader contributors"
      VALUE "FileDescription", "SDRLoader (command line)"
      VALUE "FileVersion", SDI_VERSION
      VALUE "InternalName", "sdrloader-cli"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "sdrloader-cli.exe"
      VALUE "ProductName", "SDRLoader"
      VALUE "ProductVersion", SDI_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
